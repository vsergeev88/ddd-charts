{
  "name": "ddd-charts",
  "version": "0.1.0",
  "description": "Highly customizable 3D charts for React — pie and bar charts with physically-based materials, glass effects and smooth animations. Powered by three.js and @react-three/fiber.",
  "keywords": [
    "react",
    "charts",
    "3d",
    "threejs",
    "react-three-fiber",
    "pie-chart",
    "bar-chart",
    "visualization",
    "webgl"
  ],
  "author": "Valentin Sergeev",
  "license": "MIT",
  "homepage": "https://github.com/vsergeev88/ddd-charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsergeev88/ddd-charts.git"
  },
  "bugs": {
    "url": "https://github.com/vsergeev88/ddd-charts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/ddd-charts.cjs",
  "module": "./dist/ddd-charts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ddd-charts.js",
      "require": "./dist/ddd-charts.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.156.0"
  },
  "dependencies": {
    "@react-three/drei": "^9.88.0 || ^10.0.0",
    "@react-three/postprocessing": "^3.0.4"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@react-three/test-renderer": "^9.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^28.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
